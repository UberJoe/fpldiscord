# fpldiscord configuration — copy to .env for local dev (.env is gitignored and
# loaded only in local development; on fly the real environment is injected).
#
# Each key below: required/optional · default · fly secret vs committed fly.toml [env].

# --- fly secrets (never committed — the repo is public, so snowflakes count) ---

# DISCORD_TOKEN — required · no default · fly secret
# Discord bot token.
DISCORD_TOKEN=your-bot-token

# NOTIFICATION_CHANNEL_ID — required · no default · fly secret
# Channel the daily waiver-reminder posts into.
NOTIFICATION_CHANNEL_ID=000000000000000000

# ADMIN_IDS — required, non-empty · no default · fly secret
# Comma-separated Discord user ids allowed to run /bet set and /bet archive.
ADMIN_IDS=000000000000000000,111111111111111111

# DEV_GUILD_ID — optional · no default · fly secret
# Set to a guild id for instant guild-scoped command registration in dev.
# Leave unset in production for global registration (~1 h propagation).
DEV_GUILD_ID=

# --- committed fly.toml [env] (operational, non-identifying) ---

# LEAGUE_ID — required · no default
# Draft FPL league id (64 for the 2026/27 season).
LEAGUE_ID=64

# SEASON — required · no default
# Season label, e.g. 2026/27. There is no API season id; rollover = bump + redeploy.
SEASON=2026/27

# DB_PATH — optional · default /data/fpldiscord.db
# SQLite path. Use ./fpldiscord.db for local dev.
DB_PATH=./fpldiscord.db

# PORT — optional · default 8080
# HTTP listen port. Must equal fly.toml internal_port.
PORT=8080

# LOG_LEVEL — optional · default info
# One of: debug | info | warn | error.
LOG_LEVEL=info
